ALLOWED_ORIGINS=http://localhost:5173
ANTHROPIC_API_KEY=your-key-here

# Tracing (SigNoz Cloud). Only used when started with
#   dotenv run -- opentelemetry-instrument uvicorn app.main:app
# The ingestion key belongs in .env only, never in this file.
OTEL_SERVICE_NAME=bookdna-backend
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=your-ingestion-key-here
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
