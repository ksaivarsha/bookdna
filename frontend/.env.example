# Copy to .env.local (gitignored) and fill in. Leave the token empty to run
# without analytics. The token is PostHog's public, write-only project key:
# it ends up in the browser bundle, the env file just keeps it out of git.
# Events are sent to /ingest on the app's own origin and proxied to PostHog
# (vite.config.js), so there is no host setting.
VITE_POSTHOG_PROJECT_TOKEN=
